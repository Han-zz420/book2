{
  "name": "bookshop-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "二手书平台后端 API（Cloudflare Workers + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute bookshop-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute bookshop-db --local --file=./seed.sql",
    "db:init:remote": "wrangler d1 execute bookshop-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute bookshop-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
